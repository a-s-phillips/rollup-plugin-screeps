{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "dist",
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "allowUnreachableCode": false
  },
  "exclude": ["node_modules", "dist", "test"],
  "include": ["src"]
}

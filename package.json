{
  "name": "rollup-plugin-screeps",
  "description": "Rollup Plugin for publishing your code to a Screeps server",
  "license": "MIT",
  "author": "Adam Laycock",
  "contributors": [
    "a-s-phillips (maintained fork)"
  ],
  "repository": {
    "type": "git",
